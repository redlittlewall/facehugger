#!/usr/bin/env bash
#
# Facehugger -- Entrypoint CLI
#
# Uso:
#   ./facehugger catch <caminho-do-projeto> [opcoes]
#   ./facehugger config
#   ./facehugger --help
#
# Requerimentos: bash, git, grep, find

set -euo pipefail

FACEHUGGER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION="0.2.0"

# --- Core paths -----------------------------------------------------------
DETECT_SCRIPT="$FACEHUGGER_DIR/core/detectors/detect.sh"

# --- Helpers ---------------------------------------------------------------

show_help() {
  cat <<EOF
Facehugger v$VERSION

Uso:
  ./facehugger catch <path>     Configura um projeto alvo
  ./facehugger finalize <path>  Finaliza setup apos entrevista de dominio
  ./facehugger config           Gerencia configuracoes
  ./facehugger --help           Mostra esta ajuda
  ./facehugger --version        Mostra a versao
  ./facehugger --dry-run <cmd>  Mostra o que seria gerado sem escrever

Opcoes do catch:
  --mode <rapido|semi|fresh|interactive>  Modo de execucao
  --config <nome>                          Perfil de configuracao

Modos:
  rapido       Usa config existente sem perguntar
  semi         Modo guiado com confirmacoes (padrao)
  fresh        Ignora config, pergunta tudo do zero
  interactive  Gera entrevista de dominio para o AI completar

EOF
  exit 0
}

show_version() {
  echo "Facehugger v$VERSION"
  exit 0
}

# --- Config loading -------------------------------------------------------

load_config() {
  local config_name="${1:-default}"
  local config_file="$FACEHUGGER_DIR/core/configs/${config_name}.yaml"
  local local_config="$FACEHUGGER_DIR/core/config.local.yaml"
  local mode="semi"
  local injection="principal"
  local tracker="local"
  local agent_tool="claude-code"

  if [ -f "$config_file" ]; then
    while IFS=': ' read -r key value; do
      case "$key" in
        "mode") mode="$value" ;;
        "injection") injection="$value" ;;
        "tracker") tracker="$value" ;;
        "agent_tool") agent_tool="$value" ;;
      esac
    done < <(grep -E '^(mode|injection|tracker|agent_tool):' "$config_file")
  fi

  if [ -f "$local_config" ]; then
    while IFS=': ' read -r key value; do
      case "$key" in
        "mode") mode="$value" ;;
        "injection") injection="$value" ;;
        "tracker") tracker="$value" ;;
        "agent_tool") agent_tool="$value" ;;
      esac
    done < <(grep -E '^(mode|injection|tracker|agent_tool):' "$local_config")
  fi

  echo "$mode|$injection|$tracker|$agent_tool"
}

# --- UI helpers -----------------------------------------------------------

confirm() {
  local prompt="$1"
  local default="${2:-y}"
  local yn
  if [ "$default" = "y" ]; then
    read -r -p "$prompt [Y/n] " yn || true; yn="${yn:-y}"
    case "$yn" in
      [nN]*) return 1 ;;
      *) return 0 ;;
    esac
  else
    read -r -p "$prompt [y/N] " yn || true; yn="${yn:-n}"
    case "$yn" in
      [yY]*) return 0 ;;
      *) return 1 ;;
    esac
  fi
}

menu_select() {
  local prompt="$1"
  shift
  local options=("$@")
  local i=1
  for opt in "${options[@]}"; do
    echo "  [$i] $opt"
    i=$((i + 1))
  done
  local choice
  read -r -p "$prompt [1-$((i - 1))]: " choice || true; choice="${choice:-}" || true
  echo "${choice:-1}"
}

# --- Banner ---------------------------------------------------------------

show_banner() {
  echo ""
  echo "  +-------------------------------------------+"
  echo "  |           FACEHUGGER  v$VERSION              |"
  echo "  |  Acoplando, injetando e vazando...        |"
  echo "  +-------------------------------------------+"
  echo ""
}

# --- Mode selection -------------------------------------------------------

select_mode() {
  echo ""
  echo "Como quer configurar esta execucao?"
  echo ""
  echo "  [1] Rapido (usar config existente)"
  echo "      Usa as configuracoes salvas sem perguntar nada."
  echo ""
  echo "  [2] Guiado (config existente + confirmacoes)"
  echo "      Usa a config como base, mas mostra cada escolha"
  echo "      e pergunta confirmacao antes de prosseguir."
  echo ""
  echo "  [3] Fresco (ignorar config, perguntar tudo)"
  echo "      Ignora qualquer config salva e pergunta cada"
  echo "      decisao do zero."
  echo ""
  echo "  [4] Interativo (entrevista de dominio)"
  echo "      Pergunta sobre o dominio, arquitetura e dores"
  echo "      do projeto para gerar contexto rico."
  echo ""
  echo "  [5] Gerenciar Config"
  echo "      Criar, selecionar ou editar configuracoes."
  echo ""

  local choice
  read -r -p "  Escolha [1-5] (Enter=2): " choice || true; choice="${choice:-}"
  choice="${choice:-2}"

  case "$choice" in
    1) echo "rapido" ;;
    2) echo "semi" ;;
    3) echo "fresh" ;;
    4) echo "interactive" ;;
    5)
      manage_config
      select_mode
      ;;
    *) echo "semi" ;;
  esac
}

# --- Config management ---------------------------------------------------

manage_config() {
  echo ""
  echo "Gerenciar Configuracoes"
  echo ""

  local configs
  configs=$(ls "$FACEHUGGER_DIR/core/configs/"*.yaml 2>/dev/null | xargs -n1 basename | sed 's/\.yaml$//' | grep -v '^$' || echo "nenhuma")

  if [ "$configs" = "nenhuma" ]; then
    echo "  Nenhuma configuracao encontrada."
    echo ""
    if confirm "  Criar configuracao default?"; then
      create_config "default"
    fi
    return
  fi

  echo "  Configuracoes disponiveis:"
  local i=1
  local config_list=()
  while IFS= read -r cfg; do
    echo "    [$i] $cfg"
    config_list+=("$cfg")
    i=$((i + 1))
  done < <(echo "$configs")

  echo ""
  echo "  [C] Criar nova configuracao"
  echo "  [S] Selecionar configuracao ativa"
  echo "  [E] Editar configuracao existente"
  echo "  [D] Deletar configuracao"
  echo "  [V] Voltar"
  echo ""

  local action
  read -r -p "  Escolha: " action
  case "$action" in
    [cC]) create_config ;;
    [sS]) select_active_config ;;
    [eE]) edit_config ;;
    [dD]) delete_config ;;
    *) return ;;
  esac
}

create_config() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    read -r -p "  Nome da configuracao: " name
  fi
  [ -z "$name" ] && name="default"

  echo ""
  echo "  Configurando '$name':"

  read -r -p "  Modo de execucao (rapido/semi/fresh) [semi]: " mode
  mode="${mode:-semi}"

  read -r -p "  Modo de injecao (silenciosa/principal/completa) [principal]: " injection
  injection="${injection:-principal}"

  read -r -p "  Issue tracker (github/gitlab/local) [local]: " tracker
  tracker="${tracker:-local}"

  read -r -p "  Ferramenta IA (claude-code/cursor/windsurf/outro) [claude-code]: " agent_tool
  agent_tool="${agent_tool:-claude-code}"

  cat > "$FACEHUGGER_DIR/core/configs/${name}.yaml" <<YAML
# Facehugger - Configuracao: $name
name: "$name"
mode: "$mode"
injection: "$injection"
tracker: "$tracker"
agent_tool: "$agent_tool"
YAML

  echo ""
  echo "  Configuracao '$name' criada!"
}

select_active_config() {
  local configs
  configs=$(ls "$FACEHUGGER_DIR/core/configs/"*.yaml 2>/dev/null | xargs -n1 basename | sed 's/\.yaml$//' | grep -v '^$' || echo "")
  [ -z "$configs" ] && { echo "  Nenhuma config disponivel."; return; }

  local i=1
  local config_list=()
  while IFS= read -r cfg; do
    echo "    [$i] $cfg"
    config_list+=("$cfg")
    i=$((i + 1))
  done < <(echo "$configs")

  local choice
  read -r -p "  Selecionar [#]: " choice || true; choice="${choice:-}"
  local selected="${config_list[$((choice - 1))]}"
  if [ -n "$selected" ]; then
    cat > "$FACEHUGGER_DIR/core/config.local.yaml" <<YAML
# Configuracao ativa (sobrescrita local)
active_config: "$selected"
YAML
    echo "  Configuracao '$selected' ativada!"
  fi
}

# --- Skills discovery -----------------------------------------------------

discover_skills() {
  while IFS= read -r skill_file; do
    local skill_dir
    skill_dir=$(basename "$(dirname "$skill_file")")
    local skill_name
    skill_name=$(grep -m1 'name:' "$skill_file" 2>/dev/null | sed 's/name: *//; s/^ *//; s/ *$//' || true)
    [ -z "$skill_name" ] && skill_name="$skill_dir"
    local skill_desc
    skill_desc=$(grep -m1 'description:' "$skill_file" 2>/dev/null | sed 's/description: *//; s/^ *//; s/ *$//' || true)
    local skill_path
    skill_path="${skill_file#$FACEHUGGER_DIR/}"
    echo "${skill_dir}|${skill_name}|${skill_desc}|${skill_path}"
  done < <(find "$FACEHUGGER_DIR/skills/mattpocock/skills/" -maxdepth 3 -name "SKILL.md" -not -path "*/deprecated/*" 2>/dev/null | sort || true)
}

select_skills() {
  local manifest="$1"
  local mode="$2"
  local essential_skills=""
  local optional_skills=""
  local in_section=""

  while IFS= read -r line; do
    local trimmed
    trimmed=$(echo "$line" | sed 's/^[[:space:]]*//')
    case "$trimmed" in
      "essential:") in_section="essential" ;;
      "optional:") in_section="optional" ;;
      "- "*)
        local sn
        sn=$(echo "$line" | sed 's/.*- //')
        [ "$in_section" = "essential" ] && essential_skills="$essential_skills $sn"
        [ "$in_section" = "optional" ] && optional_skills="$optional_skills $sn"
        ;;
      "recommended_skills:") ;;
      "") in_section="" ;;
      *) in_section="" ;;
    esac
  done < "$manifest"

  local all_skills
  all_skills=$(discover_skills || true)

  # Nenhuma skill recomendada
  if [ -z "$essential_skills" ] && [ -z "$optional_skills" ]; then
    echo "  Sem skills recomendadas no manifesto." >&2
    return
  fi

  # Modo rapido: apenas gera o bloco, sem interacao com usuario
  if [ "$mode" = "rapido" ]; then
    local final_skills="$essential_skills"
  else
    echo "  Essenciais:" >&2
    for s in $essential_skills; do
      local s_desc
      s_desc=$(echo "$all_skills" | grep "^${s}|" | cut -d'|' -f3 || true)
      echo "    [+] $s - ${s_desc:-skill disponivel}" >&2
    done
    echo "" >&2
    echo "  Opcionais:" >&2
    for s in $optional_skills; do
      local s_desc
      s_desc=$(echo "$all_skills" | grep "^${s}|" | cut -d'|' -f3 || true)
      echo "    [ ] $s - ${s_desc:-skill disponivel}" >&2
    done

    local final_skills="$essential_skills"
    echo "" >&2
    if confirm "  Manter selecao padrao?"; then
      : # usa essential_skills
    else
      local all_opts=""
      for s in $essential_skills $optional_skills; do
        case " $all_opts " in *" $s "*) ;; *) all_opts="$all_opts $s" ;; esac
      done
      final_skills=""
      for s in $all_opts; do
        local default_state="off"
        for es in $essential_skills; do [ "$es" = "$s" ] && default_state="on"; done
        if [ "$default_state" = "on" ]; then
          if confirm "    Remover $s?"; then : ; else final_skills="$final_skills $s"; fi
        else
          if confirm "    Adicionar $s?"; then final_skills="$final_skills $s"; fi
        fi
      done
    fi
  fi

  # Gera bloco markdown (unico stdout = retorno)
  local skills_block=""
  skills_block="$skills_block
## Skills do Matt Pocock

Skills ativos neste projeto:"
  for s in $final_skills; do
    local s_path
    s_path=$(echo "$all_skills" | grep "^${s}|" | cut -d'|' -f4 || true)
    local s_name
    s_name=$(echo "$all_skills" | grep "^${s}|" | cut -d'|' -f2 || true)
    [ -z "$s_name" ] && s_name="$s"
    [ -n "$s_path" ] && skills_block="$skills_block
- **${s_name}** - \`${s_path}\`"
  done
  skills_block="$skills_block

### Instalacao

1. Entre no diretorio do projeto.
2. Instale as skills:
   \`\`\`bash
   git clone https://github.com/mattpocock/skills.git .claude/skills
   \`\`\`
3. Execute \`/setup-matt-pocock-skills\` no Claude Code.
"

  echo "$skills_block"
}

# --- Inject rules (top-level) ----------------------------------------------

inject_rules() {
  local manifest="$1"
  local books_dir="$FACEHUGGER_DIR/vendor/agent-rules-books"
  local output=""

  if [ ! -f "$manifest" ]; then
    echo "Nenhum manifesto selecionado."
    return
  fi

  while IFS=$'\t' read -r book_line version_line; do
    local book
    book=$(echo "$book_line" | sed 's/.*book: //' | xargs)
    local version
    version=$(echo "$version_line" | sed 's/.*version: //' | xargs)
    local label
    label=$(grep -A2 "id: $book" "$FACEHUGGER_DIR/core/catalog.yaml" 2>/dev/null | grep 'label:' | sed 's/.*label: //' | head -1 | xargs || true)
    local author
    author=$(grep -A3 "id: $book" "$FACEHUGGER_DIR/core/catalog.yaml" 2>/dev/null | grep 'author:' | sed 's/.*author: //' | head -1 | xargs || true)
    local book_path
    book_path=$(grep -A3 "id: $book" "$FACEHUGGER_DIR/core/catalog.yaml" 2>/dev/null | grep 'path:' | sed 's/.*path: //' | head -1 | xargs || true)
    [ -z "$book_path" ] && book_path="$book/$book"
    [ -z "$label" ] && label="$book"
    [ -z "$author" ] && author=""

    local rule_file=""
    for v in "$version" "mini" "full" "nano"; do
      for ext in "md" "txt"; do
        local candidate="$books_dir/${book_path}.${v}.${ext}"
        if [ -f "$candidate" ]; then
          rule_file="$candidate"
          break 2
        fi
      done
    done

    output="$output
### ${label}${author:+ ($author)}
"
    if [ -n "$rule_file" ]; then
      output="$output$(cat "$rule_file" 2>/dev/null)
"
    else
      output="$output*Regras nao encontradas para $book. Execute git submodule update --init --recursive.*
"
    fi
  done < <(grep -E '^\s+- book:|^\s+version:' "$manifest" | paste - -)

  echo "$output"
}

